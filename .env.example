# Configuration Example (.env)
# Copiar este archivo a .env y rellenar con tus credenciales

# MySQL Database (para Importador y Dashboard)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=analytics_datos

# Streamlit Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
STREAMLIT_LOGGER_LEVEL=info

# Import Settings (para Importador.py)
IMPORT_LOG_PATH=./logs/import_log.txt
IMPORT_DAYS_BACK=1  # Número de días atrás para importar datos (por defecto: 1 = ayer)

# Nota: Las credenciales de Google Analytics API se manejan en el script de Colab externo
# Este proyecto solo contiene Importador.py y dashboard.py
